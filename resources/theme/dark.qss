/* CD DebugTool — GitHub Dark theme */
QWidget {
    background-color: #0D1117;
    color: #E6EDF3;
    font-family: "Noto Sans CJK SC";
}

QMainWindow, QDialog {
    background-color: #0D1117;
}

QGroupBox {
    border: 1px solid #30363D;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 6px;
    background-color: #0D1117;
    color: #E6EDF3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #E6EDF3;
    background-color: transparent;
}

QPushButton {
    background-color: #21262D;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 6px 14px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #30363D;
    border-color: #8B949E;
}

QPushButton:pressed {
    background-color: #161B22;
}

QPushButton:disabled {
    color: #484F58;
    background-color: #21262D;
    border-color: #30363D;
}

QPushButton#primaryBtn {
    background-color: #1F6FEB;
    border-color: #1F6FEB;
    color: #FFFFFF;
}

QPushButton#primaryBtn:hover {
    background-color: #388BFD;
}

QPushButton#dangerBtn {
    background-color: #DA3633;
    border-color: #DA3633;
    color: #FFFFFF;
}

QPushButton#successBtn {
    background-color: #238636;
    border-color: #238636;
    color: #FFFFFF;
}

QPushButton#warningBtn {
    background-color: #9E6A03;
    border-color: #9E6A03;
    color: #FFFFFF;
}

QPushButton#infoBtn {
    background-color: #00838F;
    border-color: #00838F;
    color: #FFFFFF;
}

QComboBox, QLineEdit {
    background-color: #161B22;
    color: #E6EDF3;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: #1F6FEB;
}

QComboBox:focus, QLineEdit:focus {
    border-color: #1F6FEB;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161B22;
    color: #E6EDF3;
    border: 1px solid #30363D;
    selection-background-color: #1F6FEB;
    selection-color: #FFFFFF;
}

QLabel {
    background-color: transparent;
    color: #E6EDF3;
}

QLabel#titleLabel {
    font-size: 16px;
    font-weight: bold;
}

QLabel#subtitleLabel {
    font-size: 12px;
    color: #8B949E;
}

QLabel#statusLabel {
    color: #8B949E;
}

QStatusBar {
    background-color: #161B22;
    color: #8B949E;
    border-top: 1px solid #30363D;
}
